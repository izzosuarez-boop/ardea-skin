# Copy to .env and fill in. Never commit .env.
# Shopify (store data, cart and checkout; the Admin API for stock and orders)
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-10

# The store's chat agent (Claude)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Supabase: conversations, cost per message, escalations, report dates
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The owner's Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
DIGEST_TZ=America/Bogota

# Salt for hashing visitor ids (rate limits)
VISITOR_HASH_SALT=

# The store's domain, the API's domain (webhooks), the portfolio it belongs to and where to hire its builder.
# The agent names only these.
STORE_HOST=
API_HOST=
SITE_HOST=
HIRE_PLATFORM=
HIRE_URL=
